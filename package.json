{
  "name": "nextjs-creative-portfolio-starter-code-files",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs --webpack",
    "build": "node scripts/next-cmd.mjs build --webpack",
    "start": "node scripts/next-cmd.mjs start",
    "lint": "eslint src",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:fitness": "vitest run --project fitness",
    "test:component": "vitest run --project component",
    "test:api": "vitest run --project api",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "npm run build && playwright test --project=chromium --project=mobile-chrome",
    "test:e2e:all": "npm run build && playwright test --project=chromium --project=webkit --project=firefox --project=mobile-chrome --project=mobile-safari",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:a11y": "npm run build && playwright test --project=a11y",
    "test:i18n": "npm run i18n:pseudo && NEXT_PUBLIC_I18N_PSEUDO=1 npm run build && playwright test --project=i18n",
    "test:security": "npm run build && playwright test --project=security",
    "test:perf": "npm run build && playwright test --project=perf",
    "test:visual": "npm run build && VISUAL=1 playwright test --project=visual",
    "test:visual:update": "node scripts/visual-baselines.mjs",
    "test:bundle": "node scripts/scan-client-bundle.mjs && node scripts/check-bundle-budget.mjs",
    "test:bundle:update": "node scripts/check-bundle-budget.mjs --update",
    "test:audit": "node scripts/audit-gate.mjs",
    "test:count": "node scripts/count-browser-cases.mjs && node scripts/count-vitest-cases.mjs",
    "i18n:data": "node scripts/i18n-data.mjs",
    "i18n:translate": "node --env-file-if-exists=.env.local scripts/i18n-translate.mjs",
    "i18n:pseudo": "node scripts/i18n-pseudo.mjs",
    "notes:translate": "node --env-file-if-exists=.env.local scripts/notes-translate.mjs",
    "i18n:audit": "node scripts/i18n-data.mjs --check && node scripts/i18n-audit.mjs",
    "test:all": "npm run lint && npm run test:coverage && npm run build && npm run test:bundle && playwright test --project=chromium --project=mobile-chrome --project=a11y --project=security --project=perf"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "ai": "^7.0.159",
    "clsx": "^2.1.1",
    "emoji-dictionary": "^1.0.12",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.70.0",
    "marked": "^18.1.3",
    "next": "^16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "nodemailer": "^10.3.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "sharp": "^0.35.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "three": "^0.162.0",
    "tldts": "^7.4.19",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/bundle-analyzer": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "fast-check": "^4.10.2",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.29"
    },
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "@auth/core": {
      "nodemailer": "$nodemailer"
    }
  }
}
