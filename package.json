{
  "name": "nextjs-creative-portfolio-starter-code-files",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/next-cmd.mjs build",
    "start": "node scripts/next-cmd.mjs start",
    "lint": "node scripts/next-cmd.mjs lint",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:property": "vitest run --project property",
    "test:fitness": "vitest run --project fitness",
    "test:component": "vitest run --project component",
    "test:api": "vitest run --project api",
    "test:changed": "vitest run --changed",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:e2e": "npm run build && playwright test --project=chromium --project=mobile-chrome",
    "test:e2e:all": "npm run build && playwright test --project=chromium --project=webkit --project=firefox --project=mobile-chrome --project=mobile-safari",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --project=a11y",
    "test:security": "playwright test --project=security",
    "test:perf": "playwright test --project=perf",
    "test:visual": "VISUAL=1 playwright test --project=visual",
    "test:visual:update": "node scripts/visual-baselines.mjs",
    "test:bundle": "node scripts/scan-client-bundle.mjs && node scripts/check-bundle-budget.mjs",
    "test:bundle:update": "node scripts/check-bundle-budget.mjs --update",
    "test:audit": "node scripts/audit-gate.mjs",
    "test:all": "npm run lint && npm run test:coverage && npm run build && npm run test:bundle && playwright test --project=chromium --project=mobile-chrome --project=a11y --project=security --project=perf"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.4",
    "clsx": "^2.1.1",
    "emoji-dictionary": "^1.0.12",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.344.0",
    "marked": "^16.4.2",
    "next": "^14.2.30",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^7.0.10",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.61.1",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "sharp": "^0.34.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.6.0",
    "three": "^0.162.0",
    "tldts": "^7.4.11",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@next/bundle-analyzer": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "fast-check": "^4.10.2",
    "ffmpeg-static": "^5.3.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "postcss": "^8",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.3.0",
    "vitest": "^4.1.11"
  }
}
