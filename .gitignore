# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/.next.nosync/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env

# scene-script working dir (raw clips + intermediate frames; override with SCRATCH=)
/.scene-work/

# local planning docs
TESTING_SOFTWARE_GITHUB_INTEGRATION_BLUEPRINT.md

# claude code
.claude/

# playwright mcp browser-session artifacts (console logs, page snapshots)
.playwright-mcp/

# playwright test-runner artifacts (issue #40 e2e smoke)
/test-results/
/playwright-report/

# guestbook local dev data (GUESTBOOK_DRIVER=json) — visitor or seeded
# messages; must never reach the public repo
/data/guestbook.json

# editor / tool temp files (e.g. crash-leftover *.tmp.<pid>.<hash>)
*.tmp
*.tmp.*
.env*
!.env.example

# Lighthouse CI report output (.github/workflows/lighthouse.yml uploads these
# as a build artifact instead — they are large, per-run, and regenerated every
# time the audit runs).
.lighthouseci/

# Google service-account keys. scripts/set-gsc-credentials.mjs documents
# passing one as `--key ./service-account-key.json`, i.e. from the repository
# root, so the obvious way to run it leaves a live RSA private key one
# `git add -A` away from a public repository — a rotate-immediately incident
# under CLAUDE.md §1, not a revertable commit. Ignored by name rather than left
# to whoever is staging that day. The key still belongs OUTSIDE the tree; this
# is the net, not the plan.
service-account-key*.json
*-service-account*.json

# issue #92 test outputs: mutation reports and Stryker's sandbox copy. Coverage
# (/coverage) and Playwright (/test-results, /playwright-report) are above.
# NOT ignored on purpose: tests/visual/__screenshots__/ (reviewed baselines).
/reports/
.stryker-tmp/
