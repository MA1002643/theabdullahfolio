# GitHub Stats API
# See README "GitHub Stats Integration" for the exact PAT scopes required.
GITHUB_TOKEN=your-github-personal-access-token
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username

# Footer "View this project on GitHub" CTA (issue #30)
# The footer colophon's signature CTA shows LIVE metadata for the repo this site
# is built from — default branch, commit count, last-push time — fetched by
# GET /api/project-repo. Owner is NEXT_PUBLIC_GITHUB_USERNAME (above); the repo
# NAME defaults to "theabdullahfolio". A fork retargets that live caption at its
# own repo with NO code change by setting NEXT_PUBLIC_PROJECT_REPO to the fork's
# repo name (resolves to <NEXT_PUBLIC_GITHUB_USERNAME>/<NEXT_PUBLIC_PROJECT_REPO>;
# reuses GITHUB_TOKEN for the fetch). Both the live caption AND the CTA's clickable
# link (projectGithubUrl in src/components/footer/footer-data.js) read these two
# vars, so setting them fully retargets the CTA — no code edit needed.
# NEXT_PUBLIC_PROJECT_REPO=theabdullahfolio

# Daily-warmup cron (issue #22)
# CRON_SECRET: any random 32+ char string — Vercel Cron passes it in the
#   `Authorization: Bearer <secret>` header to /api/daily-warmup (the
#   scheduled entrypoint in vercel.json). /api/daily-warmup then forwards
#   the same header on its internal fetches to /api/work-status?bust=1 and
#   /api/repo-refresh, so the one secret authenticates all three routes
#   (and the two downstream ones individually for manual triggers).
#   Generate with: `openssl rand -hex 32`
# BASE_URL: production URL /api/daily-warmup and /api/repo-refresh use for
#   their internal warm-up fetches (falls back to VERCEL_URL on Vercel,
#   then localhost in dev). Server-only — do NOT use the NEXT_PUBLIC_
#   prefix, which would inline the URL into client bundles.
CRON_SECRET=your-cron-secret
BASE_URL=https://your-site.vercel.app

# Multi-repo maintenance header (issue #94)
# Rollout kill-switch for the portfolio-wide header signal. The tracked
# repos themselves live in src/utils/workTrackedRepos.js (config-as-data —
# not an env var). Unset/any other value = multi-repo aggregation ON;
# set to exactly "false" to pin /api/work-status and the webhook gate back
# to the primary repo only (pre-#94 behaviour) without a code revert.
# Server-only — do NOT prefix with NEXT_PUBLIC_.
# MULTI_REPO_HEADER=false

# Maintenance-header credentials (issue #94 / #22)
# Declared here as of 2026-09-25. All three were documented in README.md's
# "Environment variables & token scopes" table and NOT here, which is the gap
# tests/unit/redactSecrets.test.js now closes: its sweep classifies every
# variable this file declares AND every one the code reads, so a credential
# cannot be introduced without being added to SECRET_ENV_VARS in
# src/app/api/_utils/redact.js or recorded there as a non-credential.
#
# GITHUB_PROJECT_TOKEN: a SEPARATE classic PAT (read:project + public_repo) for
#   the Projects v2 board query — user-owned boards are unreachable with a
#   fine-grained PAT today. Falls back to GITHUB_TOKEN when unset. Set it EMPTY
#   or not at all; an empty value behaves as absent (see CHANGELOG, the `??`
#   → `||` fix), where a blank Authorization header 401'd silently.
# GITHUB_WEBHOOK_SECRET: the HMAC secret GitHub signs deliveries with, checked by
#   /api/github-webhook against X-Hub-Signature-256. Unsigned and invalid
#   deliveries are rejected, so an unset secret disables the webhook path.
#   Generate with: `openssl rand -hex 32`
GITHUB_PROJECT_TOKEN=your-classic-project-read-pat
GITHUB_WEBHOOK_SECRET=your-webhook-hmac-secret
# Optional LLM rewrite of the header's deterministic sentence. OFF unless
# WORK_STATUS_AI_ENABLED is exactly "true" AND the key is present; every failure
# falls back to the deterministic message. The key is server-only.
# WORK_STATUS_AI_ENABLED=true
# OPENAI_API_KEY=your-openai-api-key

# Contact Form (Nodemailer SMTP)
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
RECEIVER_EMAIL=recipient@example.com
# NEXT_PUBLIC_CONTACT_EMAIL: the PUBLIC contact address the footer displays
# (`email` in src/components/footer/footer-data.js). Optional — defaults to the
# address baked into that file. Client-visible (NEXT_PUBLIC_), so it is a
# SEPARATE var from the server-only RECEIVER_EMAIL above; set both to the same
# value if you want the footer's shown address to equal the delivery inbox.
# NEXT_PUBLIC_CONTACT_EMAIL=you@example.com
# Optional — force TLS on/off (defaults to true when SMTP_PORT=465)
# SMTP_SECURE=true
# Optional — email reputation check via https://www.abstractapi.com/api/email-verification-validation-api
# When set, every contact-form address is sent to Abstract before the message
# is accepted. /privacy discloses this as a processor (PROCESSORS in
# src/lib/privacy/inventory.js), so update that row if the check changes.
# ABSTRACT_API_KEY=your-abstract-api-key

# AI message refine (POST /api/refine-message, issue #5)
# Vercel AI Gateway credential for the contact/guestbook "refine" action. Declared
# here as of 2026-09-25 — it was documented in README.md only. SERVER-ONLY: the
# route calls the model and returns text, so the key never reaches the browser.
# Unset and off-platform, the route answers 503 and the client HIDES the feature.
# On Vercel (or after `vercel env pull`) the platform injects VERCEL_OIDC_TOKEN
# and the route uses that instead, so this variable is usually unnecessary there.
# VERCEL_OIDC_TOKEN is deliberately NOT declared below: it is minted by the
# platform, never set by hand, and a placeholder for it would only invite someone
# to paste one in. It is redacted from logs all the same — see SECRET_ENV_VARS.
# AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key

# Live-location ingest (footer availability line, issue #30)
# Two SEPARATE write secrets for POST /api/location, split by how the tracker
# authenticates so the token exposed in URL logs is never the primary secret:
# LOCATION_INGEST_TOKEN: presented via `Authorization: Bearer <token>` (iOS
#   Shortcut / curl) or HTTP Basic where the password is the token (OwnTracks'
#   built-in auth). This is the header-only write secret — never put it in a URL.
# LOCATION_INGEST_QUERY_TOKEN: for URL-only trackers like Overland that can only
#   customise the endpoint URL, passed as `?token=<token>`. Query strings get
#   retained in proxy/platform/analytics logs, so keep this DISTINCT from the
#   header token and rotate it independently. Leave unset to disable the query
#   path entirely (header-only ingestion). Set both on Vercel too.
#   Generate each with: `openssl rand -hex 32`
# LOCATION_INGEST_TOKEN=your-header-ingest-secret
# LOCATION_INGEST_QUERY_TOKEN=your-separate-query-ingest-secret

# Contact-send idempotency store (Upstash for Redis via Vercel Marketplace)
# Used by /api/send-mail to dedupe retried submissions: the offline queue can
# resend a message whose success response was lost to a timeout/dropped
# connection, and this store recognises the repeated Idempotency-Key and skips
# mailing it twice. Provision via the Marketplace ("Upstash for Redis"), which
# auto-injects the vars below; `vercel env pull` syncs them locally. The route
# reads KV_REST_API_URL + KV_REST_API_TOKEN (the Marketplace names) and also
# accepts UPSTASH_REDIS_REST_URL / _TOKEN as a fallback. Use the WRITE token, not
# the READ_ONLY one. When absent the route fails OPEN (sends without dedupe), so
# local dev still works.
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your-upstash-rest-write-token
# The direct-Upstash names the same code accepts. Declared as of 2026-09-25 so
# both spellings are held by the classification sweep, rather than one being
# redacted and the other described in prose two paragraphs up.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-write-token

# Now Playing widget — live Spotify presence (issue #42)
# The floating bottom-left widget shows the owner's currently-playing (or last
# played) Spotify track. All three vars are SERVER-ONLY (never NEXT_PUBLIC_) —
# the /api/spotify route exchanges the refresh token for a short-lived access
# token server-side and returns ONLY display data (title/artist/art/accent), so
# no secret ever reaches the browser.
#
# One-time setup (see src/app/api/spotify/auth/route.js header for the full flow):
#   1. Create an app at https://developer.spotify.com/dashboard
#      Redirect URI: http://127.0.0.1:3000/api/spotify/auth  (Web API)
#      NB: Spotify BANS "localhost" in redirect URIs — use the loopback IP
#      127.0.0.1, and open the flow at http://127.0.0.1:3000 (not localhost).
#   2. Put CLIENT_ID / CLIENT_SECRET below, run `npm run dev`, then visit the
#      authorize URL from the auth route's comment and approve the scopes
#      (user-read-currently-playing, user-read-recently-played).
#   3. Copy the refresh_token the /api/spotify/auth response prints into
#      SPOTIFY_REFRESH_TOKEN below. The refresh token does not expire.
# The token is obtained LOCALLY (steps 1-3): the /api/spotify/auth helper 404s in
# production AND preview (both run as NODE_ENV=production), so the OAuth exchange
# by default completes against the 127.0.0.1 loopback redirect above — if you
# override SPOTIFY_REDIRECT_URI, register that EXACT URI with Spotify. Don't
# register a Vercel URL as a Spotify Redirect URI — it would just 404. On Vercel
# you only set the three vars below (Project → Settings → Environment Variables);
# it reads the finished SPOTIFY_REFRESH_TOKEN and never runs the auth flow itself.
#
# When these are UNSET: in production the widget stays hidden; in dev (or with
# SPOTIFY_DEMO=true) it shows a bundled demo track so you can see the UI.
# The access token + per-album accent/blur are cached in the KV store above when
# present (pure optimisation — the widget works without KV too).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Optional — force the demo track ON in a production/preview deploy (defaults to
# on in dev, off in production). Handy for showing the widget before wiring an
# account. Any value other than exactly "true" leaves it off.
# SPOTIFY_DEMO=true
# Optional — the /api/spotify/auth token helper 404s in production and, in any
# other build, serves LOOPBACK hosts only (127.0.0.1 / localhost). Set to "true"
# ONLY if you must run the one-time token flow from a non-loopback dev host (LAN
# IP, cloud dev box). NEVER set this in a public or production environment — it
# re-exposes a long-lived-token-minting endpoint.
# SPOTIFY_AUTH_ALLOW_REMOTE=true

# Guestbook (issue #40)
# GitHub OAuth via Auth.js v5, which infers these AUTH_* names automatically —
# no code references them directly. A GitHub OAuth App accepts ONE callback
# URL, so use two apps: a dev app with
#   http://localhost:3000/api/auth/callback/github
# and a production app with
#   https://ma.codes/api/auth/callback/github
# AUTH_SECRET: generate with `openssl rand -base64 32`.
AUTH_GITHUB_ID=your-github-oauth-app-client-id
AUTH_GITHUB_SECRET=your-github-oauth-app-client-secret
# Google sign-in (second provider — for visitors without a GitHub account).
# ONE Google OAuth client covers dev AND prod: unlike GitHub OAuth Apps,
# Google accepts multiple authorized redirect URIs on a single client —
# add both http://localhost:3000/api/auth/callback/google and
# https://ma.codes/api/auth/callback/google to it.
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
AUTH_SECRET=your-32-byte-random-secret
# Storage driver for guestbook messages: "redis" (Upstash — reuses the
# KV_REST_API_* credentials above) or "json" (data/guestbook.json, LOCAL DEV
# ONLY — Vercel's filesystem is ephemeral). Unset = redis whenever the KV env
# is present, else json IN DEVELOPMENT ONLY: a production server with neither
# the KV env nor an explicit driver refuses to start, as does forcing "redis"
# WITHOUT those credentials (an error naming the missing variables) — it never
# falls back to the file store, which on Vercel would accept messages and lose
# them. Setting "json" under a served production ALSO refuses to start: the
# file store is a supported path in development only.
# GUESTBOOK_DRIVER=redis
# E2E-ONLY hatch: lets a served production run the json file store anyway, for
# the Playwright suite's hermetic, disposable `next start` (playwright.config.mjs
# sets it). The value must be exactly this string — it spells the consequence,
# so no "1"/"true" unlocks it by accident. NEVER set this on Vercel: every
# guestbook write would be non-durable and differ between instances.
# GUESTBOOK_ALLOW_JSON_IN_PRODUCTION=e2e-non-durable
# Moderator allowed to DELETE any guestbook message: your IDENTITY KEY,
# github:<numeric GitHub user id> (https://api.github.com/users/<login> shows
# the id). A bare username is refused — a renamed login can be claimed by
# someone else — and leaves moderation off with one warning in the log.
GUESTBOOK_ADMIN=github:your-numeric-github-user-id

# ── Discoverability (issue #32) ──────────────────────────────────────────────
# Canonical origin. Override ONLY for a fork, or for a preview deployment that
# should carry self-referential canonicals instead of pointing at production.
# Deliberately NOT wired to VERCEL_URL: a preview whose canonical names the
# preview de-duplicates production away, so opting in has to be explicit.
# No trailing slash.
# NEXT_PUBLIC_SITE_ORIGIN=https://ma.codes

# Google Search Console domain verification. Not strictly a secret — it is
# published in a meta tag on every page the moment it is set — but it is
# deployment configuration, so the NAME lives here and the value in Vercel.
# Unset, the verification key is omitted entirely rather than rendering an
# empty meta tag. Get it from Search Console -> Settings -> Ownership
# verification -> HTML tag (the content="..." value only).
GOOGLE_SITE_VERIFICATION=your-search-console-verification-token

# 🔴 REAL SECRET. Service-account key for the Search Console API, used by
# /api/seo-report (wired as a third step in /api/daily-warmup's fan-out).
# Value in Vercel ONLY — never in this file, never in a commit.
#
# Must be the service-account JSON key, BASE64-ENCODED:
#     base64 -i service-account-key.json
# Base64 rather than raw JSON because the key contains literal newlines inside
# private_key and every environment-variable UI mangles those differently.
#
# Unset is a supported state: /api/seo-report answers 503 with a 'skipped'
# reason and daily-warmup deliberately does not count that as a failed run.
GSC_SERVICE_ACCOUNT_KEY=your-base64-encoded-service-account-json

# The Search Console property identifier. Defaults to sc-domain:<host> (a
# Domain property). Set this only if the property is a URL-prefix one, in which
# case it is the full origin WITH a trailing slash.
# GSC_SITE_URL=https://ma.codes/

# GA4 measurement ID. LIVE as of #141, and safe to set: the tag renders only
# inside the consent gate (src/components/privacy/ConsentedAnalytics.jsx), so
# setting this does not start measuring anybody — it makes the tag available to
# load for a visitor who has agreed, and for nobody else.
#
# Not a secret: it is inlined into the client bundle by design, which is what
# NEXT_PUBLIC_ means and why a measurement ID is the right kind of value to
# carry it. Leaving it UNSET is a supported state, not a misconfiguration —
# local development, every preview deployment and every fork run without one,
# and none of them should report into the production property. Unset also keeps
# `window.gtag` undefined, which is the structural gate `trackEvent` relies on.
#
# Consent Mode v2 stays denied on all four signals even after a visitor accepts,
# so no `_ga` cookie is ever written. See docs/seo.md sections 8, 14 and 17.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Optional tunables ─────────────────────────────────────────────────────────
# Declared 2026-09-28. The code has read all of these for months, but they were
# documented only in comments beside the code that reads them, so nobody
# deploying the site could learn from this file that they exist.
# tests/fitness/envHygiene.test.js now fails when a variable the code reads is
# missing here. None is a credential, and every one has a safe default, so leave
# them unset unless a plan limit or a model id needs overriding.
#
# GitHub GraphQL budgets for /api/github-stats, in ms. Per call, per helper, and
# across one whole cold-cache request. The defaults (8000 / 9000 / 9000) keep a
# full refresh inside Vercel Hobby's 10 s function limit; raise them on Pro.
# GITHUB_TIMEOUT_MS=8000
# GITHUB_OVERALL_TIMEOUT_MS=9000
# GITHUB_OVERALL_BUDGET_MS=9000
#
# Cron timings, in ms. CRON_WARM_TIMEOUT_MS bounds each warm fetch
# /api/repo-refresh makes (default 15000). CRON_RUN_BUDGET_MS can only LOWER
# /api/daily-warmup's run budget below 75% of its declared maxDuration, never
# raise it. SEO_REPORT_TIMEOUT_MS bounds the Search Console call (default 10000).
# CRON_WARM_TIMEOUT_MS=15000
# CRON_RUN_BUDGET_MS=
# SEO_REPORT_TIMEOUT_MS=10000
#
# AI Gateway model slug for the contact form's "refine" rewrite. Override when
# a model id is retired, without a code change.
# REFINE_MODEL=anthropic/claude-haiku-4.5
#
# Spotify OAuth redirect for the one-time refresh-token helper at
# /api/spotify/auth. Defaults to the loopback URL Spotify requires for local dev.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/auth
#
# Where the json guestbook driver (GUESTBOOK_DRIVER=json, local dev only) keeps
# its file. Defaults to data/guestbook.json, which is gitignored.
# GUESTBOOK_JSON_PATH=
