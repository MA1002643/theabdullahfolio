# GitHub Stats API
# See README "GitHub Stats Integration" for the exact PAT scopes required.
GITHUB_TOKEN=your-github-personal-access-token
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username

# Daily-warmup cron (issue #22)
# CRON_SECRET: any random 32+ char string — Vercel Cron passes it in the
#   `Authorization: Bearer <secret>` header to /api/daily-warmup (the
#   scheduled entrypoint in vercel.json). /api/daily-warmup then forwards
#   the same header on its internal fetches to /api/work-status?bust=1 and
#   /api/repo-refresh, so the one secret authenticates all three routes
#   (and the two downstream ones individually for manual triggers).
#   Generate with: `openssl rand -hex 32`
# BASE_URL: production URL /api/daily-warmup and /api/repo-refresh use for
#   their internal warm-up fetches (falls back to VERCEL_URL on Vercel,
#   then localhost in dev). Server-only — do NOT use the NEXT_PUBLIC_
#   prefix, which would inline the URL into client bundles.
CRON_SECRET=your-cron-secret
BASE_URL=https://your-site.vercel.app

# Contact Form (Nodemailer SMTP)
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
RECEIVER_EMAIL=recipient@example.com
# Optional — force TLS on/off (defaults to true when SMTP_PORT=465)
# SMTP_SECURE=true
# Optional — email reputation check via https://www.abstractapi.com/api/email-verification-validation-api
# ABSTRACT_API_KEY=your-abstract-api-key

# Contact-send idempotency store (Upstash for Redis via Vercel Marketplace)
# Used by /api/send-mail to dedupe retried submissions: the offline queue can
# resend a message whose success response was lost to a timeout/dropped
# connection, and this store recognises the repeated Idempotency-Key and skips
# mailing it twice. Provision via the Marketplace ("Upstash for Redis"), which
# auto-injects the vars below; `vercel env pull` syncs them locally. The route
# reads KV_REST_API_URL + KV_REST_API_TOKEN (the Marketplace names) and also
# accepts UPSTASH_REDIS_REST_URL / _TOKEN as a fallback. Use the WRITE token, not
# the READ_ONLY one. When absent the route fails OPEN (sends without dedupe), so
# local dev still works.
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your-upstash-rest-write-token
