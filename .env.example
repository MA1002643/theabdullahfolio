# GitHub Stats API
# See README "GitHub Stats Integration" for the exact PAT scopes required.
GITHUB_TOKEN=your-github-personal-access-token
NEXT_PUBLIC_GITHUB_USERNAME=your-github-username

# Repo-refresh cron (issue #22)
# CRON_SECRET: any random 32+ char string — Vercel Cron passes it in the
#   `Authorization: Bearer <secret>` header to /api/repo-refresh. Generate with:
#   `openssl rand -hex 32`
# NEXT_PUBLIC_BASE_URL: production URL the cron should hit (falls back to
#   VERCEL_URL on Vercel, then localhost in dev).
CRON_SECRET=your-cron-secret
NEXT_PUBLIC_BASE_URL=https://your-site.vercel.app

# Contact Form (Nodemailer SMTP)
# For Gmail, use an App Password: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
RECEIVER_EMAIL=recipient@example.com
# Optional — force TLS on/off (defaults to true when SMTP_PORT=465)
# SMTP_SECURE=true
# Optional — email reputation check via https://www.abstractapi.com/api/email-verification-validation-api
# ABSTRACT_API_KEY=your-abstract-api-key
